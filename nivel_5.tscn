[sub_resource type="Resource" id="Pregunta_01"]
script = ExtResource("pregunta_script")
texto = "¿Cómo se llamaba la llama que Lumi encontró al inicio de la historia?"
opciones = Array[String](["Lila", "Luna", "Luma"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_02"]
script = ExtResource("pregunta_script")
texto = "¿Qué tenía Luna en su cuello?"
opciones = Array[String](["Collar de estrellas", "Listón dorado", "Amuleto mágico"])

[sub_resource type="Resource" id="Pregunta_03"]
script = ExtResource("pregunta_script")
texto = "¿Por qué Lumi ayudó a Luna?"
opciones = Array[String](["Porque quería encontrar su camino", "Porque se mezclaron las letras", "Porque Luna perdió su collar"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_04"]
script = ExtResource("pregunta_script")
texto = "¿Quién ayudó a Lumi a cruzar el río?"
opciones = Array[String](["Tilo la tortuga", "Mia la mariposa", "Bruno el búho"])
correcta = 3

[sub_resource type="Resource" id="Pregunta_05"]
script = ExtResource("pregunta_script")
texto = "¿Cómo creó Lumi un puente sobre el río?"
opciones = Array[String](["Construyendo un barco", "Formando palabras mágicas", "Saltando sobre las piedras"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_06"]
script = ExtResource("pregunta_script")
texto = "¿Dónde encontró Lumi las bayas mágicas?"
opciones = Array[String](["En el Bosque Brillante", "En la Cueva de Colores", "En la Pradera Mágica"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_07"]
script = ExtResource("pregunta_script")
texto = "¿Qué le enseñó Tilo la Tortuga a Lumi?"
opciones = Array[String](["A tener paciencia", "A correr rápido", "A encontrar más bayas"])

[sub_resource type="Resource" id="Pregunta_08"]
script = ExtResource("pregunta_script")
texto = "¿Cómo se reveló la verdadera apariencia de Lumi?"
opciones = Array[String](["Con el reflejo del sol", "Con la lluvia", "Con un hechizo de Nico"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_09"]
script = ExtResource("pregunta_script")
texto = "¿Qué personaje tenía alas brillantes?"
opciones = Array[String](["Mia la mariposa", "Bruno el búho", "Nico el zorro"])

[sub_resource type="Resource" id="Pregunta_10"]
script = ExtResource("pregunta_script")
texto = "¿Qué celebraban los personajes en la Cascada Brillante?"
opciones = Array[String](["La llegada del invierno", "Que Lumi era especial tal como es", "La fiesta de Luna"])
correcta = 2

[sub_resource type="Resource" id="Pregunta_11"]
script = ExtResource("pregunta_script")
texto = "¿Qué hace especial a Lumi en la historia?"
opciones = Array[String](["Sus colores únicos", "Su velocidad", "Su fuerza"])

[sub_resource type="Resource" id="Pregunta_12"]
script = ExtResource("pregunta_script")
texto = "¿Por qué es importante ser uno mismo?"
opciones = Array[String](["Porque cada persona es especial y única", "Para ser igual a los demás", "Porque es una regla del bosque"])

[sub_resource type="Resource" id="Pregunta_13"]
script = ExtResource("pregunta_script")
texto = "¿Qué mensaje nos deja la historia de Lumi?"
opciones = Array[String](["Que debemos aceptarnos y valorar lo que nos hace únicos", "Que siempre debemos cambiar para encajar", "Que ser diferentes nos hace menos importantes"])

